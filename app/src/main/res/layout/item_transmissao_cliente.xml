<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_card"
    android:padding="14dp"
    android:layout_marginBottom="8dp">

    <TextView
        android:id="@+id/tvAvatarInicial"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:background="@drawable/bg_avatar"
        android:gravity="center"
        android:textColor="@color/vermelho_accent"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginEnd="12dp"
        tools:text="J" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvNomeCliente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/branco"
            android:textSize="15sp"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="João da Silva" />

        <TextView
            android:id="@+id/tvWhatsappCliente"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/cinza_texto_escuro"
            android:textSize="12sp"
            android:layout_marginTop="2dp"
            tools:text="+55 31 99999-8888" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="26dp"
        android:layout_height="26dp">

        <ImageView
            android:id="@+id/ivMarcado"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:src="@drawable/ic_check_circle"
            android:visibility="gone"
            android:contentDescription="Selecionado" />

        <View
            android:id="@+id/viewDesmarcado"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:background="@drawable/bg_circle_vazio" />
    </FrameLayout>

</LinearLayout>
