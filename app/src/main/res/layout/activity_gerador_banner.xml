<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_fundo">

    <!-- Topo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:contentDescription="Voltar" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Gerador de Banner"
            android:textColor="@color/branco"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollPrincipal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Categoria -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selo de destaque"
                android:textColor="@color/cinza_texto"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="18dp">

                <TextView
                    android:id="@+id/chipDestaque"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_selecionado"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="Destaque"
                    android:textColor="@color/branco"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipTop10Brasil"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_normal"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="Top 10 Brasil"
                    android:textColor="@color/branco"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipTop10Mundo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_normal"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="Top 10 Mundo"
                    android:textColor="@color/branco"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipLancamento"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_normal"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="Lançamento"
                    android:textColor="@color/branco"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Busca -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Filme ou série"
                android:textColor="@color/cinza_texto"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <EditText
                    android:id="@+id/etBusca"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:padding="14dp"
                    android:textColor="@color/branco"
                    android:textColorHint="@color/cinza_hint"
                    android:textSize="14sp"
                    android:hint="Ex: Round 6, Matrix..."
                    android:imeOptions="actionSearch"
                    android:singleLine="true" />

                <ImageButton
                    android:id="@+id/btnBuscar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_botao_primario"
                    android:src="@drawable/ic_search"
                    android:contentDescription="Buscar" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBusca"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/vermelho_accent"
                android:visibility="gone"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvErroBusca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/vermelho_accent"
                android:textSize="12.5sp"
                android:visibility="gone"
                android:layout_marginBottom="10dp"
                tools:text="Falha ao buscar no TMDB"
                tools:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvResultados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_marginBottom="18dp"
                tools:listitem="@layout/item_tmdb_resultado"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvLabelTitulo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Título no banner (pode editar)"
                android:textColor="@color/cinza_texto"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <EditText
                android:id="@+id/etTitulo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:textColor="@color/branco"
                android:textColorHint="@color/cinza_hint"
                android:textSize="14sp"
                android:hint="Nome do filme ou série"
                android:singleLine="true"
                android:visibility="gone"
                android:layout_marginBottom="14dp"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvLabelSinopse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sinopse (puxada do TMDB, edite se quiser)"
                android:textColor="@color/cinza_texto"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <EditText
                android:id="@+id/etSinopse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="3"
                android:gravity="top|start"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:textColor="@color/branco"
                android:textColorHint="@color/cinza_hint"
                android:textSize="14sp"
                android:hint="Um trecho curto sobre o filme/série"
                android:visibility="gone"
                android:layout_marginBottom="14dp"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvLabelFrase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Frase de chamada (opcional)"
                android:textColor="@color/cinza_texto"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <EditText
                android:id="@+id/etFrase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:textColor="@color/branco"
                android:textColorHint="@color/cinza_hint"
                android:textSize="14sp"
                android:hint="Ex: Assista agora! · Já disponível no catálogo"
                android:visibility="gone"
                android:layout_marginBottom="14dp"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvLabelFormato"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Formato"
                android:textColor="@color/cinza_texto"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <LinearLayout
                android:id="@+id/linhaFormatosFilme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_marginBottom="16dp"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvLabelModeloFilme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Escolha o modelo (toque para selecionar)"
                android:textColor="@color/cinza_texto"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <HorizontalScrollView
                android:id="@+id/scrollModelosFilme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/galeriaModelosFilme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/btnGerarBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_botao_primario"
                android:gravity="center"
                android:padding="16dp"
                android:text="Gerar Banner"
                android:textColor="@color/branco"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginBottom="20dp"
                tools:visibility="visible" />

            <!-- Preview -->
            <ImageView
                android:id="@+id/ivPreviewBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:background="@drawable/bg_imagem_preview"
                android:visibility="gone"
                android:layout_marginBottom="16dp"
                tools:visibility="visible"
                tools:src="@drawable/ic_image" />

            <LinearLayout
                android:id="@+id/layoutBotoesFinais"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/btnSalvar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_botao_secundario"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_save" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Salvar"
                        android:textColor="@color/branco"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnCompartilhar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_botao_primario"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_share" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Compartilhar"
                        android:textColor="@color/branco"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
