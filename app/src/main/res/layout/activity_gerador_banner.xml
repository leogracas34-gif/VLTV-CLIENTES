<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_fundo">

    <!-- Topo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:contentDescription="Voltar" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Gerador de Banner"
            android:textColor="@color/branco"
            android:textSize="20sp"
            android:textStyle="bold" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollPrincipal"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- Tipo de banner -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="20dp">

                <TextView
                    android:id="@+id/chipModoFilme"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_chip_selecionado"
                    android:gravity="center"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="Filme ou Série"
                    android:textColor="@color/branco"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipModoPrecos"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_normal"
                    android:gravity="center"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp"
                    android:text="Preços dos Planos"
                    android:textColor="@color/branco"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/containerModoPrecos"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginBottom="20dp"
                tools:visibility="visible">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Escolha o plano"
                    android:textColor="@color/cinza_texto"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:id="@+id/linhaPlanos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/blocoValor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Valor no banner (pode editar)"
                    android:textColor="@color/cinza_texto"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/etValorPreco"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input"
                        android:padding="14dp"
                        android:textColor="@color/branco"
                        android:textColorHint="@color/cinza_hint"
                        android:textSize="14sp"
                        android:hint="Ex: 40,00"
                        android:inputType="text"
                        android:digits="0123456789,."
                        android:singleLine="true"
                        android:layout_marginBottom="14dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/blocoQtd"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quantos amigos indicar para ganhar 1 mês?"
                    android:textColor="@color/cinza_texto"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/etQtdAmigos"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_input"
                        android:padding="14dp"
                        android:textColor="@color/branco"
                        android:textColorHint="@color/cinza_hint"
                        android:textSize="14sp"
                        android:hint="1"
                        android:text="1"
                        android:inputType="number"
                        android:maxLength="2"
                        android:singleLine="true"
                        android:layout_marginBottom="14dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/blocoFoto"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Foto no modelo Festa (opcional - de preferência PNG sem fundo)"
                    android:textColor="@color/cinza_texto"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="14dp">

                        <TextView
                            android:id="@+id/btnEscolherFoto"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_botao_secundario"
                            android:gravity="center"
                            android:padding="13dp"
                            android:text="Escolher foto da galeria"
                            android:textColor="@color/branco"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/btnRemoverFoto"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="@drawable/bg_botao_secundario"
                            android:gravity="center"
                            android:paddingStart="18dp"
                            android:paddingEnd="18dp"
                            android:paddingTop="13dp"
                            android:paddingBottom="13dp"
                            android:text="Remover"
                            android:textColor="@color/branco"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLabelExtra"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Frase personalizada (opcional)"
                    android:textColor="@color/cinza_texto"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <EditText
                    android:id="@+id/etTextoExtra"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_input"
                    android:padding="14dp"
                    android:textColor="@color/branco"
                    android:textColorHint="@color/cinza_hint"
                    android:textSize="14sp"
                    android:hint="Ex: Aproveite 3 meses de conteúdo incrível!"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Escolha o modelo"
                    android:textColor="@color/cinza_texto"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none"
                    android:layout_marginBottom="16dp">

                    <LinearLayout
                        android:id="@+id/galeriaModelosPreco"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Cor do banner"
                    android:textColor="@color/cinza_texto"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />

                <LinearLayout
                    android:id="@+id/linhaCores"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Formato"
                    android:textColor="@color/cinza_texto"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="8dp" />
                <LinearLayout
                    android:id="@+id/linhaFormatos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="20dp" />

                <TextView
                    android:id="@+id/btnGerarBannerPrecos"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_botao_primario"
                    android:gravity="center"
                    android:padding="16dp"
                    android:text="Gerar banner"
                    android:textColor="@color/branco"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/containerModoFilme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

            <!-- Categoria -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Selo de destaque"
                android:textColor="@color/cinza_texto"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="18dp">

                <TextView
                    android:id="@+id/chipDestaque"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_selecionado"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="Destaque"
                    android:textColor="@color/branco"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipTop10Brasil"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_normal"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="Top 10 Brasil"
                    android:textColor="@color/branco"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipTop10Mundo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    android:background="@drawable/bg_chip_normal"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="Top 10 Mundo"
                    android:textColor="@color/branco"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/chipLancamento"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_chip_normal"
                    android:gravity="center"
                    android:paddingTop="10dp"
                    android:paddingBottom="10dp"
                    android:text="Lançamento"
                    android:textColor="@color/branco"
                    android:textSize="11.5sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Busca -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Filme ou série"
                android:textColor="@color/cinza_texto"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp">

                <EditText
                    android:id="@+id/etBusca"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/bg_input"
                    android:padding="14dp"
                    android:textColor="@color/branco"
                    android:textColorHint="@color/cinza_hint"
                    android:textSize="14sp"
                    android:hint="Ex: Round 6, Matrix..."
                    android:imeOptions="actionSearch"
                    android:singleLine="true" />

                <ImageButton
                    android:id="@+id/btnBuscar"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_botao_primario"
                    android:src="@drawable/ic_search"
                    android:contentDescription="Buscar" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressBusca"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/vermelho_accent"
                android:visibility="gone"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/tvErroBusca"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/vermelho_accent"
                android:textSize="12.5sp"
                android:visibility="gone"
                android:layout_marginBottom="10dp"
                tools:text="Falha ao buscar no TMDB"
                tools:visibility="visible" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvResultados"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                android:layout_marginBottom="18dp"
                tools:listitem="@layout/item_tmdb_resultado"
                tools:visibility="visible" />

            <!-- Sinopse e geração (o título não é repetido em texto - o
                 pôster oficial do TMDB já traz o nome do filme/série na
                 própria arte) -->
            <TextView
                android:id="@+id/tvLabelSinopse"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sinopse (puxada do TMDB, edite se quiser)"
                android:textColor="@color/cinza_texto"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <EditText
                android:id="@+id/etSinopse"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="3"
                android:gravity="top|start"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:textColor="@color/branco"
                android:textColorHint="@color/cinza_hint"
                android:textSize="14sp"
                android:hint="Um trecho curto sobre o filme/série"
                android:visibility="gone"
                android:layout_marginBottom="14dp"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvLabelFrase"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Frase de chamada (opcional)"
                android:textColor="@color/cinza_texto"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <EditText
                android:id="@+id/etFrase"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:textColor="@color/branco"
                android:textColorHint="@color/cinza_hint"
                android:textSize="14sp"
                android:hint="Ex: Assista agora! · Já disponível no catálogo"
                android:visibility="gone"
                android:layout_marginBottom="14dp"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvLabelModeloFilme"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Escolha o modelo"
                android:textColor="@color/cinza_texto"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <HorizontalScrollView
                android:id="@+id/scrollModelosFilme"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="16dp"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/galeriaModelosFilme"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <TextView
                android:id="@+id/btnGerarBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_botao_primario"
                android:gravity="center"
                android:padding="16dp"
                android:text="Gerar Banner"
                android:textColor="@color/branco"
                android:textSize="15sp"
                android:textStyle="bold"
                android:visibility="gone"
                android:layout_marginBottom="20dp"
                tools:visibility="visible" />

            </LinearLayout>
            <!-- fecha containerModoFilme -->

            <!-- Preview -->
            <ImageView
                android:id="@+id/ivPreviewBanner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:background="@drawable/bg_imagem_preview"
                android:visibility="gone"
                android:layout_marginBottom="16dp"
                tools:visibility="visible"
                tools:src="@drawable/ic_image" />

            <LinearLayout
                android:id="@+id/layoutBotoesFinais"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone"
                tools:visibility="visible">

                <LinearLayout
                    android:id="@+id/btnSalvar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="8dp"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_botao_secundario"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_save" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Salvar"
                        android:textColor="@color/branco"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnCompartilhar"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="@drawable/bg_botao_primario"
                    android:padding="14dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_share" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Compartilhar"
                        android:textColor="@color/branco"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
