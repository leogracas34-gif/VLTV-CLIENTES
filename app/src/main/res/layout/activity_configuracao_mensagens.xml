<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_fundo"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageButton
                android:id="@+id/btnVoltar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                android:contentDescription="Voltar" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="Mensagens de Aviso"
                android:textColor="@color/branco"
                android:textSize="18sp"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chave Pix"
            android:textColor="@color/branco"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Usada futuramente nas mensagens de cobrança. Recomendado usar uma chave dedicada (ex: e-mail), em vez do celular."
            android:textColor="@color/cinza_texto_escuro"
            android:textSize="11.5sp"
            android:layout_marginBottom="10dp" />

        <EditText
            android:id="@+id/etChavePix"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:hint="Ex: financeiro@vltvplay.tech"
            android:textColor="@color/branco"
            android:textColorHint="@color/cinza_hint"
            android:inputType="textEmailAddress"
            android:padding="14dp"
            android:layout_marginBottom="20dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/borda_card"
            android:layout_marginBottom="18dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Use {nome} e {dias} — serão substituídos automaticamente ao enviar."
            android:textColor="@color/cinza_texto_escuro"
            android:textSize="12sp"
            android:layout_marginBottom="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Faltam 3 dias"
            android:textColor="@color/cinza_texto"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etMsg3Dias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:textColor="@color/branco"
            android:textColorHint="@color/cinza_hint"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:padding="14dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Faltam 2 dias"
            android:textColor="@color/cinza_texto"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etMsg2Dias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:textColor="@color/branco"
            android:textColorHint="@color/cinza_hint"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:padding="14dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Falta 1 dia"
            android:textColor="@color/cinza_texto"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etMsg1Dia"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:textColor="@color/branco"
            android:textColorHint="@color/cinza_hint"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:padding="14dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Plano já venceu"
            android:textColor="@color/cinza_texto"
            android:textSize="12sp"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etMsgVencido"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:textColor="@color/branco"
            android:textColorHint="@color/cinza_hint"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:padding="14dp"
            android:layout_marginBottom="24dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/borda_card"
            android:layout_marginBottom="20dp" />

        <TextView
            android:id="@+id/btnConfigBackend"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_botao_secundario"
            android:gravity="center"
            android:text="Configurar Servidor de Envio (VPS)"
            android:textColor="@color/branco"
            android:textSize="14sp"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginBottom="24dp" />

        <TextView
            android:id="@+id/btnSalvarMensagens"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_botao_primario"
            android:gravity="center"
            android:text="Salvar"
            android:textColor="@color/branco"
            android:textSize="15sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

    </LinearLayout>
</ScrollView>
