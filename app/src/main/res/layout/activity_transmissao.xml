<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_fundo">

    <!-- Topo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/btnVoltar"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_close"
            android:contentDescription="Voltar" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:text="Transmissão"
            android:textColor="@color/branco"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnGeradorBanner"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_image"
            android:contentDescription="Gerador de banner" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- Mensagem -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mensagem"
                android:textColor="@color/cinza_texto"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <EditText
                android:id="@+id/etMensagem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="4"
                android:gravity="top|start"
                android:background="@drawable/bg_input"
                android:padding="14dp"
                android:textColor="@color/branco"
                android:textColorHint="@color/cinza_hint"
                android:textSize="14sp"
                android:hint="Ex: Adicionamos novos episódios de [série] e o filme [nome] no catálogo!"
                tools:text="Adicionamos novos episódios!" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Campos automáticos de cada cliente: {nome}, {login} e {vencimento}."
                android:textColor="@color/cinza_texto_escuro"
                android:textSize="11.5sp"
                android:layout_marginTop="6dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <TextView
                    android:id="@+id/btnModeloRenovacao"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Usar modelo de renovação"
                    android:textColor="@color/branco"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:background="?attr/selectableItemBackground"
                    android:padding="4dp" />

                <TextView
                    android:id="@+id/btnSalvarModelo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Salvar como modelo"
                    android:textColor="@color/vermelho_accent"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:background="?attr/selectableItemBackground"
                    android:padding="4dp" />
            </LinearLayout>

            <!-- Imagem opcional -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Imagem (opcional)"
                android:textColor="@color/cinza_texto"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="6dp" />

            <FrameLayout
                android:id="@+id/layoutSemImagem"
                android:layout_width="match_parent"
                android:layout_height="90dp"
                android:background="@drawable/bg_imagem_preview">

                <LinearLayout
                    android:id="@+id/btnEscolherImagem"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:background="?attr/selectableItemBackground">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_image"
                        app:tint="@color/cinza_texto" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Toque para anexar uma imagem"
                        android:textColor="@color/cinza_texto"
                        android:textSize="13sp" />
                </LinearLayout>
            </FrameLayout>

            <FrameLayout
                android:id="@+id/layoutComImagem"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivPreviewImagem"
                    android:layout_width="match_parent"
                    android:layout_height="180dp"
                    android:scaleType="centerCrop"
                    android:background="@drawable/bg_imagem_preview"
                    tools:src="@drawable/ic_image" />

                <ImageButton
                    android:id="@+id/btnRemoverImagem"
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:layout_gravity="top|end"
                    android:layout_margin="8dp"
                    android:background="@drawable/bg_avatar"
                    android:src="@drawable/ic_close"
                    android:padding="7dp"
                    android:contentDescription="Remover imagem" />
            </FrameLayout>

            <!-- Clientes -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Enviar para"
                    android:textColor="@color/cinza_texto"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvContadorSelecionados"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/vermelho_accent"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="12dp"
                    tools:text="3 de 15 selecionados" />

                <TextView
                    android:id="@+id/btnSelecionarTodos"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Selecionar todos"
                    android:textColor="@color/branco"
                    android:textSize="12.5sp"
                    android:textStyle="bold"
                    android:background="?attr/selectableItemBackground"
                    android:padding="4dp" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvClientesTransmissao"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                tools:listitem="@layout/item_transmissao_cliente"
                tools:itemCount="3" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Botão enviar, fixo embaixo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="@color/bg_card">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="52dp">

            <TextView
                android:id="@+id/btnEnviarTransmissao"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_botao_primario"
                android:gravity="center"
                android:text="Enviar"
                android:textColor="@color/branco"
                android:textSize="15sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressEnvio"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/branco"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

</LinearLayout>
